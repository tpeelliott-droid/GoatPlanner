# Firebase project config — from Firebase console → Project settings → General → Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (Cloud Messaging) — Project settings → Cloud Messaging → Web configuration → generate key pair.
VITE_FIREBASE_VAPID_KEY=

# Set to "true" to run against the local Firebase emulator suite (see README).
VITE_USE_FIREBASE_EMULATORS=false

# Base URL for deployed Cloud Functions (used for the iCal feed link).
# Defaults to https://us-central1-<project-id>.cloudfunctions.net if unset.
VITE_FUNCTIONS_BASE_URL=
